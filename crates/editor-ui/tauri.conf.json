{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoMD",
  "version": "0.1.0",
  "identifier": "com.womd.editor",
  "build": {
    "frontendDist": "./dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WoMD — Markdown Editor",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' tauri:; img-src 'self' data: https: tauri: asset:",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/Data-Bike/womd/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyQkQwODQ3MkU3RTQxNkMKUldSc1FYNHVSd2k5RWhmTXpRTEZaNWsvbUtoSnRVc29FeDBKdDFwNEtjamZLMmJHNlZYMkQrVGkK"
    }
  }
}
