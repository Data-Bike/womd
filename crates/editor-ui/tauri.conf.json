{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoMD",
  "version": "0.1.0",
  "identifier": "com.womd.editor",
  "build": {
    "frontendDist": "./dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WoMD — Markdown Editor",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' tauri:; img-src 'self' data: https: tauri: asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
