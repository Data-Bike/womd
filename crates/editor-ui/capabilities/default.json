{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capability for all WoMD editor windows",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:event:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
